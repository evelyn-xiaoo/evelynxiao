                <img src={photo11.src} id="photo11">
                <img src={photo12.src} id="photo12">
                <img src={photo13.src} id="photo13">
                <img src={photo14.src} id="photo14">
                <img src={photo15.src} id="photo15">
                <img src={photo16.src} id="photo16">
                <img src={photo17.src} id="photo17">
                <img src={photo18.src} id="photo18">
                <img src={photo19.src} id="photo19">
                <img src={photo20.src} id="photo20">
                <img src={photo21.src} id="photo21">
                <img src={photo22.src} id="photo22">
            </div>
            <div class="slider-nav row-12">
                
                <a href="#photo1"></a>
                <a href="#photo2"></a>
                <a href="#photo3"></a>
                <a href="#photo4"></a>
                <a href="#photo5"></a>
