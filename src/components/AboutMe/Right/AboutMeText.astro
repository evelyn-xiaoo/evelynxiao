---
import "bootstrap/dist/css/bootstrap.min.css";
---

<div class="info col flex-col">
    <div>
        <h2>Evelyn Xiao</h2>
    </div>
    <div class="row flex-row space-between contact">
        <div class="col-6">
            <a class="" href="mailto:xiao.ev@northeastern.edu" target="_blank">xiao.ev@northeastern.edu</a>
        </div>
        <div class="col-6 ms-auto text-end">
            <div class="links">
                <a class="" href="https://www.linkedin.com/in/evelynxiao" target="_blank">
                    <img class="icon" src="/icons/linkedin.png" alt="LinkedIn icon"/>
                </a>
                <a class="" href="https://www.github.com/evelyn-xiaoo" target="_blank">
                    <img class="icon" src="/icons/github.png" alt="Github icon"/>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    * {
        color: white;
        font-family: Georgia, 'Times New Roman', Times, serif;
    }

    h2 {
        font-size: 75px;
        text-wrap:nowrap;
    }

    .info {
        display: flex;
        flex-direction: column;
    }
    .box {
        width: 100%;
        display: flex;
        flex-direction: row;
        padding-left: 3rem;
        padding-right: 3rem;
    }

    .links {
        display: flex;            /* required for gap to take effect */
        justify-content: flex-end;/* keep them aligned to the right */
        align-items: center;
        gap: 0.5rem;
    }

    .links a {
        color: white;
        text-decoration: none;
        font-size: 1rem;
    }

    .contact {
        border: 1px solid white;
        padding: 1rem;
        margin: 0rem;
    }

    /* Make the icon smaller and consistent */
    .links .icon {
        width: 24px;       /* adjust size as desired: 16–24px works well */
        height: 100%;      /* match width for square icons */
        object-fit: contain;
        display: block;    /* avoids extra inline spacing around the image */
    }

</style>